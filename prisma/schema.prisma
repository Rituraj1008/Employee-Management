generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RoleType {
  SUPER_ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum ProjectMemberRole {
  LEAD
  MEMBER
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         RoleType @default(EMPLOYEE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee      Employee?
  createdTasks  Task[]    @relation("TaskCreator")
  assignedTasks Task[]    @relation("TaskAssignee")

  createdProjects      Project[]               @relation("ProjectCreator")
  managerChangesMade   ProjectManagerHistory[] @relation("ManagerChanger")

  @@map("users")
}

// ─── Organization ────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  managerId String?    @map("manager_id")
  manager   Employee?  @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[] @relation("DepartmentEmployees")

  @@map("departments")
}

model Designation {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("designations")
}

model Employee {
  id           String         @id @default(uuid())
  userId       String         @unique @map("user_id")
  employeeCode String         @unique @map("employee_code")
  firstName    String         @map("first_name")
  lastName     String         @map("last_name")
  phone        String?
  joiningDate  DateTime       @map("joining_date")
  status       EmployeeStatus @default(ACTIVE)
  profileImage String?        @map("profile_image")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId  String?      @map("department_id")
  department    Department?  @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  designationId String?      @map("designation_id")
  designation   Designation? @relation(fields: [designationId], references: [id])

  managedDept     Department[]   @relation("DepartmentManager")
  managedTeams    Team[]         @relation("TeamManager")
  teamMemberships TeamMember[]
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  taskComments    TaskComment[]
  salary          EmployeeSalary?
  salarySlips     SalarySlip[]

  managedProjects    Project[]               @relation("ProjectManager")
  projectMemberships ProjectMember[]
  weeklyTasks        WeeklyTask[]
  workNotes          WorkNote[]
  managerHistory     ProjectManagerHistory[] @relation("ManagerHistoryEmployee")

  @@index([userId])
  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model Attendance {
  id                String           @id @default(uuid())
  employeeId        String           @map("employee_id")
  date              DateTime         @map("date") @db.Date
  checkInTime       DateTime?        @map("check_in_time")
  checkOutTime      DateTime?        @map("check_out_time")
  workingMinutes    Int?             @map("working_minutes")
  teaBreakMinutes   Int              @default(0) @map("tea_break_minutes")
  lunchBreakMinutes Int              @default(0) @map("lunch_break_minutes")
  status            AttendanceStatus @default(PRESENT)
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}

// ─── Leave ────────────────────────────────────────────────────────────────────

model LeaveType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  daysPerYear Int      @map("days_per_year")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@map("leave_types")
}

model LeaveBalance {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  leaveTypeId   String   @map("leave_type_id")
  year          Int
  totalDays     Int      @map("total_days")
  usedDays      Int      @default(0) @map("used_days")
  remainingDays Int      @map("remaining_days")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String      @id @default(uuid())
  employeeId  String      @map("employee_id")
  leaveTypeId String      @map("leave_type_id")
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  totalDays   Int         @map("total_days")
  reason      String
  status      LeaveStatus @default(PENDING)
  reviewedBy  String?     @map("reviewed_by")
  reviewNote  String?     @map("review_note")
  reviewedAt  DateTime?   @map("reviewed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

// ─── Teams ────────────────────────────────────────────────────────────────────

model Team {
  id          String       @id @default(uuid())
  name        String
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  managerId   String?      @map("manager_id")
  manager     Employee?    @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members     TeamMember[]
  projects    Project[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([managerId])
  @@map("teams")
}

model TeamMember {
  id         String   @id @default(uuid())
  teamId     String   @map("team_id")
  employeeId String   @map("employee_id")
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now()) @map("joined_at")

  @@unique([teamId, employeeId])
  @@index([teamId])
  @@index([employeeId])
  @@map("team_members")
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?    @map("due_date") @db.Date
  createdById  String       @map("created_by_id")
  assignedToId String?      @map("assigned_to_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  createdBy  User          @relation("TaskCreator", fields: [createdById], references: [id])
  assignedTo User?         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  comments   TaskComment[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdById])
  @@map("tasks")
}

// ─── Salary ───────────────────────────────────────────────────────────────────

model EmployeeSalary {
  id            String   @id @default(uuid())
  employeeId    String   @unique @map("employee_id")
  baseSalary    Decimal  @map("base_salary") @db.Decimal(14, 2)
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_salaries")
}

model SalarySlip {
  id              String   @id @default(uuid())
  employeeId      String   @map("employee_id")
  month           Int
  year            Int
  baseSalary      Decimal  @map("base_salary") @db.Decimal(14, 2)
  workingDays     Int      @map("working_days")
  presentDays     Int      @default(0) @map("present_days")
  halfDays        Int      @default(0) @map("half_days")
  absentDays      Int      @default(0) @map("absent_days")
  paidLeaveDays   Int      @default(0) @map("paid_leave_days")
  unpaidLeaveDays Int      @default(0) @map("unpaid_leave_days")
  deductions      Decimal  @default(0) @db.Decimal(14, 2)
  netSalary       Decimal  @map("net_salary") @db.Decimal(14, 2)
  generatedById   String   @map("generated_by_id")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([month, year])
  @@map("salary_slips")
}

model TaskComment {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  employeeId String   @map("employee_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([taskId])
  @@map("task_comments")
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  deadline    DateTime?     @db.Date
  teamId      String?       @map("team_id")
  managerId   String?       @map("manager_id")
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  team           Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  manager        Employee?               @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdBy      User                    @relation("ProjectCreator", fields: [createdById], references: [id])
  members        ProjectMember[]
  weeklyTasks    WeeklyTask[]
  workNotes      WorkNote[]
  managerHistory ProjectManagerHistory[]

  @@index([teamId])
  @@index([managerId])
  @@index([status])
  @@map("projects")
}

// Audit trail: every time admin changes the project manager, a row is added here.
// removedAt = null means this person is currently the active manager.
model ProjectManagerHistory {
  id           String    @id @default(uuid())
  projectId    String    @map("project_id")
  managerId    String    @map("manager_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  removedAt    DateTime? @map("removed_at")
  changedById  String    @map("changed_by_id")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  manager   Employee @relation("ManagerHistoryEmployee", fields: [managerId], references: [id])
  changedBy User     @relation("ManagerChanger", fields: [changedById], references: [id])

  @@index([projectId])
  @@map("project_manager_history")
}

model ProjectMember {
  id         String            @id @default(uuid())
  projectId  String            @map("project_id")
  employeeId String            @map("employee_id")
  role       ProjectMemberRole @default(MEMBER)
  joinedAt   DateTime          @default(now()) @map("joined_at")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([employeeId])
  @@map("project_members")
}

model WeeklyTask {
  id           String     @id @default(uuid())
  projectId    String     @map("project_id")
  assignedToId String     @map("assigned_to_id")
  title        String
  description  String?
  weekNumber   Int        @map("week_number")
  year         Int
  status        TaskStatus @default(TODO)
  progress      Float      @default(0)
  dueDate       DateTime?  @map("due_date") @db.Date
  managerRemark String?    @map("manager_remark")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo Employee    @relation(fields: [assignedToId], references: [id])
  dailyTasks DailyTask[]

  @@index([projectId])
  @@index([assignedToId])
  @@index([weekNumber, year])
  @@map("weekly_tasks")
}

model DailyTask {
  id           String     @id @default(uuid())
  weeklyTaskId String     @map("weekly_task_id")
  title        String
  description  String?
  date         DateTime   @db.Date
  status       TaskStatus @default(TODO)
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  weeklyTask     WeeklyTask      @relation(fields: [weeklyTaskId], references: [id], onDelete: Cascade)
  checklistItems ChecklistItem[]

  @@index([weeklyTaskId])
  @@index([date])
  @@map("daily_tasks")
}

model ChecklistItem {
  id          String    @id @default(uuid())
  dailyTaskId String    @map("daily_task_id")
  text        String
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  dailyTask DailyTask @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)

  @@index([dailyTaskId])
  @@map("checklist_items")
}

model WorkNote {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  employeeId String   @map("employee_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([projectId])
  @@index([employeeId])
  @@map("work_notes")
}
